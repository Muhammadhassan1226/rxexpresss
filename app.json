{
  "expo": {
    "name": "RxExpresss",
    "slug": "rxexpresss",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rx_icon.png",
    "splash": {
      "backgroundColor": "#5893d4", 
      "image": "./assets/images/splash.png", 
      "resizeMode": "contain"
    },
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby places"
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.rxexpress.app",
      "permissions": [
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash.png",
        "backgroundColor": "#5893d4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5893d4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4a2bb382-5824-4afe-a5eb-d1d859e37e24"
      }
    }
  }
}
